          "bun install*": "ask",
          "npx *": "ask",
          "git add*": "ask",
          "git commit*": "ask",
          "git push*": "ask",
          "git commit --amend*": "deny",
          "git push --force*": "deny",
          "git reset --hard*": "deny",
          "git clean *": "deny",
          "git rebase *": "deny",
          "git reset*": "deny",
          "rm *": "deny",
          "find * -delete*": "deny",
          "sudo *": "deny"
        }
      }
